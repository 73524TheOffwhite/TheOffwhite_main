# Public browser configuration. The anon key is safe to expose when RLS is enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: legacy Google Places reviews (homepage now uses Elfsight embed in GoogleReviews.tsx).
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_PLACE_ID=
# VITE_GOOGLE_PLACE_QUERY=The Off White Bar & Grill Navelim Goa

# Homepage Instagram feed uses SociableKit embed in InstagramFeed.tsx (embed id 25711609).


# Set these with `supabase secrets set`; never expose them as VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ALLOWED_ORIGIN=https://YOUR_PUBLIC_SITE_DOMAIN
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
RESERVATIONS_EMAIL=info@theoffwhite.com
EVENTS_EMAIL=info@theoffwhite.com
